+          {
+            "field_path": "do[7]",
+            "before": null,
+            "after": {
+              "t": "لو المادة دخلت العين، اغسلها بميّه جارية فورًا لمدة ١٥ دقيقة على الأقل، واطلب مساعدة طبية فورًا.",
+              "en": "If a chemical gets into the eyes, flush them with water right away. Continue to flush the eyes with running water for at least 15 minutes. Get medical help right away.",
+              "src": "mlp:chemical-burn"
+            }
+          }
+        ]
+      }
