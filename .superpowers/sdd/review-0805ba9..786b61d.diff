+          "licence": null
+        }
+      ],
+      "actionable_lines": [
+        {
+          "field_path": "do[0]",
+          "text": "اتصل بالإسعاف على طول عشان تجيب مساعدة طبية فورية.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Depending on the specific cause and type of shock, symptoms will include one or more of the following: Anxiety or agitation/restlessness Bluish lips and fingernails (cyanosis) Chest pain Confusion Dizziness , lightheadedness, or faintness Pale, cool, clammy skin Low or no urine output Profuse sweating , moist skin Rapid but weak pulse Shallow breathing Being unconscious (unresponsive) First Aid Take the following steps if you think a person is in shock: Call 911 or the local emergency number for immediate medical help. Check the person's airway, breathing, and circulation.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[1]",
+          "text": "اكشف على مجرى هوا الشخص وتنفّسه والدورة الدموية. ولو لزم الأمر، ابدأ تنفّس صناعي وإنعاش قلبي رئوي (CPR).",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Depending on the specific cause and type of shock, symptoms will include one or more of the following: Anxiety or agitation/restlessness Bluish lips and fingernails (cyanosis) Chest pain Confusion Dizziness , lightheadedness, or faintness Pale, cool, clammy skin Low or no urine output Profuse sweating , moist skin Rapid but weak pulse Shallow breathing Being unconscious (unresponsive) First Aid Take the following steps if you think a person is in shock: Call 911 or the local emergency number for immediate medical help. Check the person's airway, breathing, and circulation. If necessary, begin rescue breathing and CPR .",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[2]",
+          "text": "حتى لو الشخص بيتنفّس لوحده، فضّل تتابع معدّل تنفّسه كل ٥ دقايق على الأقل لحد ما تيجي المساعدة.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Depending on the specific cause and type of shock, symptoms will include one or more of the following: Anxiety or agitation/restlessness Bluish lips and fingernails (cyanosis) Chest pain Confusion Dizziness , lightheadedness, or faintness Pale, cool, clammy skin Low or no urine output Profuse sweating , moist skin Rapid but weak pulse Shallow breathing Being unconscious (unresponsive) First Aid Take the following steps if you think a person is in shock: Call 911 or the local emergency number for immediate medical help. Check the person's airway, breathing, and circulation. If necessary, begin rescue breathing and CPR . Even if the person is able to breathe on their own, continue to check rate of breathing at least every 5 minutes until help arrives. If the person is conscious and does not have an injury to the head, leg, neck, or spine, place the person in the shock position.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[3]",
+          "text": "لو الشخص واعي ومفيش عنده إصابة في الراس أو الرجل أو الرقبة أو العمود الفقري، حطّه في وضع الصدمة: نيّمه على ضهره وارفع رجليه حوالي ٣٠ سم. ماترفعش راسه. ولو رفع رجليه هيوجّعه أو يضرّه، سيبه نايم على مسطّح.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If necessary, begin rescue breathing and CPR . Even if the person is able to breathe on their own, continue to check rate of breathing at least every 5 minutes until help arrives. If the person is conscious and does not have an injury to the head, leg, neck, or spine, place the person in the shock position. Lay the person on their back and elevate their legs about 12 inches (30 centimeters). Do not elevate their head. If raising the legs will cause pain or potential harm, leave the person lying flat. Give appropriate first aid for any wounds, injuries, or illnesses.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[4]",
+          "text": "قدّم الإسعافات المناسبة لأي جروح أو إصابات أو أمراض.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Lay the person on their back and elevate their legs about 12 inches (30 centimeters). Do not elevate their head. If raising the legs will cause pain or potential harm, leave the person lying flat. Give appropriate first aid for any wounds, injuries, or illnesses. Keep the person warm and comfortable.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[5]",
+          "text": "دفّي الشخص وخلّيه مرتاح، وفكّ أي هدوم ضيّقة.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Do not elevate their head. If raising the legs will cause pain or potential harm, leave the person lying flat. Give appropriate first aid for any wounds, injuries, or illnesses. Keep the person warm and comfortable. Loosen tight clothing. IF THE PERSON VOMITS OR DROOLS Turn the person or their head to one side to prevent choking if you do not suspect an injury to the spine.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[6]",
+          "text": "لو مش شاكّ في إصابة بالعمود الفقري، لُفّ الشخص أو راسه على جنب عشان تمنع الشرقة.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If raising the legs will cause pain or potential harm, leave the person lying flat. Give appropriate first aid for any wounds, injuries, or illnesses. Keep the person warm and comfortable. Loosen tight clothing. IF THE PERSON VOMITS OR DROOLS Turn the person or their head to one side to prevent choking if you do not suspect an injury to the spine. If a spinal injury is suspected, \"log roll\" the person instead.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[7]",
+          "text": "لو فيه شكّ في إصابة بالعمود الفقري، لفّه بطريقة «اللفّة الواحدة» بدل كده: خلّي راسه ورقبته وضهره على خط واحد، ولفّ الجسم والراس كوحدة واحدة.",
+          "source_id": "mlp:shock",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Keep the person warm and comfortable. Loosen tight clothing. IF THE PERSON VOMITS OR DROOLS Turn the person or their head to one side to prevent choking if you do not suspect an injury to the spine. If a spinal injury is suspected, \"log roll\" the person instead. To do this, keep the person's head, neck, and back in line, and roll the body and head as a unit. DO NOT In case of shock: Do not give the person anything by mouth, including anything to eat or drink.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[0]",
+          "text": "ماتديش الشخص أي حاجة بقّه، لا أكل ولا شرب.",
+          "source_id": "mlp:shock",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "If a spinal injury is suspected, \"log roll\" the person instead. To do this, keep the person's head, neck, and back in line, and roll the body and head as a unit. DO NOT In case of shock: Do not give the person anything by mouth, including anything to eat or drink. Do not move the person with a known or suspected spinal injury .",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[1]",
+          "text": "ماتحرّكش الشخص لو عنده إصابة معروفة أو مشكوك فيها في العمود الفقري.",
+          "source_id": "mlp:shock",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "To do this, keep the person's head, neck, and back in line, and roll the body and head as a unit. DO NOT In case of shock: Do not give the person anything by mouth, including anything to eat or drink. Do not move the person with a known or suspected spinal injury .",
+          "qualifier_or_exception": "No limiting qualifier in this supporting context.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[2]",
+          "text": "ماتستنّاش أعراض الصدمة الخفيفة تبقى أوحش قبل ما تطلب المساعدة الطبية الطارئة.",
+          "source_id": "mlp:shock",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "To do this, keep the person's head, neck, and back in line, and roll the body and head as a unit. DO NOT In case of shock: Do not give the person anything by mouth, including anything to eat or drink. Do not move the person with a known or suspected spinal injury . Do not wait for milder shock symptoms to worsen before calling for emergency medical help. When to Contact a Medical Professional Call 911 or the local emergency number any time a person has symptoms of shock.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        }
+      ],
