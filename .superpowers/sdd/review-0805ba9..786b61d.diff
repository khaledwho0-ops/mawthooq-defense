+          },
+          {
+            "field_path": "do[2].t",
+            "before": "لو واعي، ادّيله مشروب يرشف منه بالراحة — زي مشروب رياضي، أو ميّه بشوية ملح.",
+            "after": "لو واعي، ادّيله مشروب رياضي، أو ميّه ساقعة عادية، يرشف منها بالراحة."
