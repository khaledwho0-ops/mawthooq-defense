+    {
+      "card_id": "breathing-difficulty",
+      "title": {
+        "ar": "صعوبة في التنفّس",
+        "en": "Breathing difficulties - first aid"
+      },
+      "level": 4,
+      "card_sha256": "026cef62c31122343c0d969993c8dc8d37033d960ed701ea7c151e51f208ea90",
+      "sources": [
+        {
+          "source_id": "mlp:breathing-difficulty",
+          "url": "https://medlineplus.gov/ency/article/000007.htm",
+          "filename": "medlineplus-gov-ency-article-000007-htm-24cf5c4a9c.html",
+          "sha256": "7e14bcbb408560411ffdefa84228df8344983032b7cb5f1a41e25c59a3eb2e26",
+          "retrieval_date": "2026-08-02",
+          "retrieved_at": "2026-08-02T15:16:12.608Z",
+          "final_url": "https://medlineplus.gov/ency/article/000007.htm",
+          "source_metadata_sha256": "f8fc45e36d",
+          "source_metadata_retrieved": null,
+          "licence": null
+        }
+      ],
+      "actionable_lines": [
+        {
+          "field_path": "do[0]",
+          "text": "اتأكد إن مجرى الهوا مفتوح، وإنه بيتنفّس، وإن نبضه شغّال. ولو محتاج، ابدأ إنعاش قلبي رئوي (CPR).",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If an injury is causing breathing difficulty, they might be bleeding or have a visible wound. First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse. If necessary, begin CPR .",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[1]",
+          "text": "فكّ أي هدوم ضيّقة عليه.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "First Aid",
+          "source_excerpt": "First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse. If necessary, begin CPR . Loosen any tight clothing. Help the person use any prescribed medicine (such as an asthma inhaler, nitroglycerin, or home oxygen).",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[2]",
+          "text": "ساعده ياخد أي دوا موصوف له (زي بخّاخة الربو، أو النيتروجليسرين، أو أكسجين البيت).",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "First Aid",
+          "source_excerpt": "First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse. If necessary, begin CPR . Loosen any tight clothing. Help the person use any prescribed medicine (such as an asthma inhaler, nitroglycerin, or home oxygen). Continue to monitor the person's breathing and pulse until medical help arrives.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[3]",
+          "text": "فضل راقب تنفّسه ونبضه لحد ما المساعدة الطبية توصل. وماتفتكرش إنه بقى أحسن لو بطّلت تسمع أصوات التنفّس الغريبة زي الصفير.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "First Aid",
+          "source_excerpt": "First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse. If necessary, begin CPR . Loosen any tight clothing. Help the person use any prescribed medicine (such as an asthma inhaler, nitroglycerin, or home oxygen). Continue to monitor the person's breathing and pulse until medical help arrives. Do not assume that the person's condition is improving if you can no longer hear abnormal breath sounds, such as wheezing. If there are open wounds in the neck or chest, they must be closed immediately, especially if air bubbles appear in the wound.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[4]",
+          "text": "لو جرح الصدر بيسحب هوا، غطّيه ببلاستيك أو شاش عليه فازلين وثبّته من ٣ نواحي؛ سيب ناحية مفتوحة.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If there are open wounds in the neck or chest, they must be closed immediately, especially if air bubbles appear in the wound. Bandage such wounds at once. A sucking chest wound allows air to enter the person's chest cavity with each breath. This can cause a collapsed lung . Bandage the wound with plastic wrap, a plastic bag, or gauze pads covered with petroleum jelly, sealing it on three sides, leaving one side unsealed. This creates a valve to prevent air from entering the chest through the wound, while allowing trapped air to escape from the chest through the unsealed side.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[0]",
+          "text": "ماتديهوش أكل ولا شرب.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Bandage the wound with plastic wrap, a plastic bag, or gauze pads covered with petroleum jelly, sealing it on three sides, leaving one side unsealed. This creates a valve to prevent air from entering the chest through the wound, while allowing trapped air to escape from the chest through the unsealed side. DO NOT Do not: Give the person food or drink. Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[1]",
+          "text": "ماتحركوش لو فيه إصابة في الراس أو الرقبة أو الصدر أو مجرى الهوا، إلا لو مفيش منّه بُد. ولو لازم تحرّكه، احمي رقبته وثبّتها.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "This creates a valve to prevent air from entering the chest through the wound, while allowing trapped air to escape from the chest through the unsealed side. DO NOT Do not: Give the person food or drink. Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[2]",
+          "text": "ماتحطّش مخدّة تحت راسه — ده ممكن يقفل مجرى الهوا.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "DO NOT Do not: Give the person food or drink. Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary. Protect and stabilize the neck if the person must be moved. Place a pillow under the person's head. This can close the airway.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[3]",
+          "text": "ماتستنّاش تشوف هيتحسّن ولا لأ قبل ما تجيب مساعدة طبية — دوّر على المساعدة على طول.",
+          "source_id": "mlp:breathing-difficulty",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary. Protect and stabilize the neck if the person must be moved. Place a pillow under the person's head. This can close the airway. Wait to see if the person's condition improves before getting medical help. Get help immediately.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        }
+      ],
+      "source_qualifiers": [
+        {
+          "id": "call-immediately",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "They may be: Breathing rapidly Unable to breathe lying down and need to sit up to breathe Very anxious and agitated Sleepy or confused They might have other symptoms, including: Dizziness or lightheadedness Pain Fever Cough Nausea Vomiting Bluish lips, fingers, and fingernails Chest moving in an unusual way Gurgling, wheezing , or making whistling sounds Muffled voice or difficulty speaking Coughing up blood Rapid or irregular heartbeat Sweating If an allergy is causing the breathing problem, they might have a rash or swelling of the face, tongue, or throat. If an injury is causing breathing difficulty, they might be bleeding or have a visible wound. First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse.",
+          "disposition": "Carried by redFlags and whoToCall.",
+          "verdict": "PASS"
+        },
+        {
+          "id": "prescribed-medicine-only",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "First Aid If someone is having breathing difficulty, call 911 or your local emergency number right away, then: Check the person's airway, breathing, and pulse. If necessary, begin CPR . Loosen any tight clothing. Help the person use any prescribed medicine (such as an asthma inhaler, nitroglycerin, or home oxygen).",
+          "disposition": "Carried by do[2].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "silent-wheeze-not-improvement",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "Help the person use any prescribed medicine (such as an asthma inhaler, nitroglycerin, or home oxygen). Continue to monitor the person's breathing and pulse until medical help arrives. Do not assume that the person's condition is improving if you can no longer hear abnormal breath sounds, such as wheezing.",
+          "disposition": "Carried completely by do[3].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "three-sided-chest-seal",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "A sucking chest wound allows air to enter the person's chest cavity with each breath. This can cause a collapsed lung . Bandage the wound with plastic wrap, a plastic bag, or gauze pads covered with petroleum jelly, sealing it on three sides, leaving one side unsealed.",
+          "disposition": "Carried by do[4].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "injury-movement-exception",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "This creates a valve to prevent air from entering the chest through the wound, while allowing trapped air to escape from the chest through the unsealed side. DO NOT Do not: Give the person food or drink. Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary.",
+          "disposition": "Carried by dont[1], including neck stabilization if moved.",
+          "verdict": "PASS"
+        },
+        {
+          "id": "no-pillow-airway",
+          "source_id": "mlp:breathing-difficulty",
+          "source_excerpt": "DO NOT Do not: Give the person food or drink. Move the person if there has been a head, neck, chest or airway injury, unless it is absolutely necessary. Protect and stabilize the neck if the person must be moved. Place a pillow under the person's head. This can close the airway.",
+          "disposition": "Carried by dont[2].",
+          "verdict": "PASS"
+        }
+      ],
+      "overall_verdict": "PASS",
+      "reviewer_note": "Human full-card review against the complete fetched First Aid, DO NOT, and escalation context; no heuristic was used to award PASS.",
+      "remediation": {
+        "changed": true,
+        "before_card_sha256": "73a739166711b3e3e7e3b625f04ce705f2446967a2ae5c849209706e5a27150e",
+        "after_card_sha256": "026cef62c31122343c0d969993c8dc8d37033d960ed701ea7c151e51f208ea90",
+        "modified_fields": [
+          {
+            "field_path": "do[4].t",
+            "before": "لو فيه جروح مفتوحة في الرقبة أو الصدر، لازم تتقفل على طول، خصوصًا لو طالع منها فقاقيع هوا. اربطها بضمّادة حالًا.",
+            "after": "لو جرح الصدر بيسحب هوا، غطّيه ببلاستيك أو شاش عليه فازلين وثبّته من ٣ نواحي؛ سيب ناحية مفتوحة."
