+      "level": 5,
+      "card_sha256": "67a37ea777d68b24b689f6a9e703db56a39d45ac7a32b04dbb9c3df8d6144ceb",
+      "sources": [
+        {
+          "source_id": "mlp:unconsciousness",
+          "url": "https://medlineplus.gov/ency/article/000022.htm",
+          "filename": "medlineplus-gov-ency-article-000022-htm-6a9c016e54.html",
+          "sha256": "b4adebf16c028ab36478858e713a4e7efb77a578ee3c7e2888ee5d4e0cbaa7b3",
+          "retrieval_date": "2026-08-02",
+          "retrieved_at": "2026-08-02T15:16:12.611Z",
+          "final_url": "https://medlineplus.gov/ency/article/000022.htm",
+          "source_metadata_sha256": "b4adebf16c",
+          "source_metadata_retrieved": null,
+          "licence": null
+        }
+      ],
+      "actionable_lines": [
+        {
+          "field_path": "do[0]",
+          "text": "راجع مجرى الهوا والتنفس والنبض بشكل متكرر. لو محتاج، ابدأ الإنعاش القلبي الرئوي.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "First Aid If someone is awake but less alert than usual, ask a few simple questions, such as: What is your name? What is the date? How old are you? Wrong answers or not being able to answer the question suggest a change in mental status. If a person is unconscious or has a change in mental status, follow these first aid steps: Call or tell someone to call 911 or the local emergency number. Check the person's airway, breathing, and pulse frequently. If necessary, begin CPR .",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[1]",
+          "text": "لو بيتنفّس ونايم على ضهره، وإنت مش شاكك في إصابة في العمود الفقري، لفّه بحذر ناحيتك على جنبه. اثني الرجل اللي فوق بحيث الفخذ والركبة يبقوا بزاوية قائمة. ميّل راسه لورا بالراحة عشان مجرى الهوا يفضل مفتوح. لو التنفس أو النبض وقف في أي وقت، رجّعه على ضهره وابدأ الإنعاش القلبي الرئوي.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If a person is unconscious or has a change in mental status, follow these first aid steps: Call or tell someone to call 911 or the local emergency number. Check the person's airway, breathing, and pulse frequently. If necessary, begin CPR . If the person is breathing and lying on their back, and you do not think there is a spinal injury , carefully roll the person toward you onto their side. Bend the top leg so both hip and knee are at right angles. Gently tilt their head back to keep the airway open. If breathing or pulse stops at any time, roll the person onto their back and begin CPR.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[2]",
+          "text": "لو شاكك في إصابة في العمود الفقري، سيبه مكان ما لقيته طول ما التنفس مستمر. لو رجّع، لف جسمه كله مرة واحدة على جنبه. اسند رقبته وضهره عشان الراس والجسم يفضلوا في نفس الوضع وإنت بتلفّه.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Bend the top leg so both hip and knee are at right angles. Gently tilt their head back to keep the airway open. If breathing or pulse stops at any time, roll the person onto their back and begin CPR. If you think there is a spinal injury, leave the person where you found them (as long as breathing continues). If the person vomits, roll the entire body at one time to their side. Support their neck and back to keep the head and body in the same position while you roll. Keep the person warm until medical help arrives.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[3]",
+          "text": "دفّيه لحد ما المساعدة الطبية توصل.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If you think there is a spinal injury, leave the person where you found them (as long as breathing continues). If the person vomits, roll the entire body at one time to their side. Support their neck and back to keep the head and body in the same position while you roll. Keep the person warm until medical help arrives. If you see a person fainting, try to prevent a fall.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[4]",
+          "text": "لو شايفه بيُغمى عليه، حاول تمنعه من الوقوع. مدّده على الأرض وارفع رجليه حوالي ١٢ بوصة، يعني ٣٠ سنتيمتر.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If the person vomits, roll the entire body at one time to their side. Support their neck and back to keep the head and body in the same position while you roll. Keep the person warm until medical help arrives. If you see a person fainting, try to prevent a fall. Lay the person flat on the floor and raise their feet about 12 inches (30 centimeters). If fainting is likely due to low blood sugar , give the person something sweet to eat or drink only when they become conscious.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[5]",
+          "text": "لو غالبًا الإغماء سببه انخفاض سكر الدم، ادّيه حاجة مسكّرة ياكلها أو يشربها بس بعد ما يفوق.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If you see a person fainting, try to prevent a fall. Lay the person flat on the floor and raise their feet about 12 inches (30 centimeters). If fainting is likely due to low blood sugar , give the person something sweet to eat or drink only when they become conscious. If the person is unconscious from choking: Begin CPR .",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[6]",
+          "text": "لو شايف حاجة سايبة سادة مجرى الهوا، حاول تشيلها. لو الحاجة محشورة في زوره، ماتحاولش تمسكها؛ ده ممكن يزقّها لجوه مجرى الهوا أكتر.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If fainting is likely due to low blood sugar , give the person something sweet to eat or drink only when they become conscious. If the person is unconscious from choking: Begin CPR . Chest compressions may help dislodge the object. If you see something blocking the airway and it is loose, try to remove it. If the object is lodged in the person's throat, do not try to grasp it. This can push the object farther into the airway. Continue CPR and keep checking to see if the object is dislodged until medical help arrives.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[7]",
+          "text": "كمّل الإنعاش القلبي الرئوي، وفضّل راجع إذا الحاجة اتحركت من مكانها، لحد ما المساعدة الطبية توصل.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "First Aid",
+          "source_excerpt": "If you see something blocking the airway and it is loose, try to remove it. If the object is lodged in the person's throat, do not try to grasp it. This can push the object farther into the airway. Continue CPR and keep checking to see if the object is dislodged until medical help arrives. DO NOT Do not give an unconscious person any food or drink.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[0]",
+          "text": "ماتديش الشخص الفاقد الوعي أي أكل أو شرب.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "If the object is lodged in the person's throat, do not try to grasp it. This can push the object farther into the airway. Continue CPR and keep checking to see if the object is dislodged until medical help arrives. DO NOT Do not give an unconscious person any food or drink. Do not leave the person alone.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[1]",
+          "text": "ماتسيبوش لوحده.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "This can push the object farther into the airway. Continue CPR and keep checking to see if the object is dislodged until medical help arrives. DO NOT Do not give an unconscious person any food or drink. Do not leave the person alone. Do not place a pillow under the head of an unconscious person.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[2]",
+          "text": "ماتحطّش مخدة تحت راس الشخص الفاقد الوعي.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Continue CPR and keep checking to see if the object is dislodged until medical help arrives. DO NOT Do not give an unconscious person any food or drink. Do not leave the person alone. Do not place a pillow under the head of an unconscious person. Do not slap an unconscious person's face or splash water on their face to try to revive them.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[3]",
+          "text": "ماتضربوش على وشه وماترشش مية على وشه عشان تحاول تفوّقه.",
+          "source_id": "mlp:unconsciousness",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Continue CPR and keep checking to see if the object is dislodged until medical help arrives. DO NOT Do not give an unconscious person any food or drink. Do not leave the person alone. Do not place a pillow under the head of an unconscious person. Do not slap an unconscious person's face or splash water on their face to try to revive them. When to Contact a Medical Professional Call 911 or the local emergency number if the person is unconscious and: Does not return to consciousness quickly (within a minute) Has fallen down or been injured, especially if they are bleeding Has diabetes Has seizures Has lost bowel or bladder control Is not breathing Is pregnant Is over age 50 Call 911 or the local emergency number if the person regains consciousness, but: Feels chest pain, pressure, or discomfort, or has a pounding or irregular heartbeat Cannot speak, has vision problems, or cannot move their arms and legs Prevention To prevent becoming unconscious or fainting: Avoid situations where your blood sugar level gets too low.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        }
+      ],
+      "source_qualifiers": [
+        {
+          "id": "side-position-no-spinal-injury",
+          "source_id": "mlp:unconsciousness",
+          "source_excerpt": "If a person is unconscious or has a change in mental status, follow these first aid steps: Call or tell someone to call 911 or the local emergency number. Check the person's airway, breathing, and pulse frequently. If necessary, begin CPR . If the person is breathing and lying on their back, and you do not think there is a spinal injury , carefully roll the person toward you onto their side.",
+          "disposition": "Carried by do[1].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "spinal-injury-leave-if-breathing",
+          "source_id": "mlp:unconsciousness",
+          "source_excerpt": "Gently tilt their head back to keep the airway open. If breathing or pulse stops at any time, roll the person onto their back and begin CPR. If you think there is a spinal injury, leave the person where you found them (as long as breathing continues).",
+          "disposition": "Carried by do[2].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "low-sugar-only-conscious",
+          "source_id": "mlp:unconsciousness",
+          "source_excerpt": "Lay the person flat on the floor and raise their feet about 12 inches (30 centimeters). If fainting is likely due to low blood sugar , give the person something sweet to eat or drink only when they become conscious.",
+          "disposition": "Carried by do[5].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "loose-versus-lodged-object",
+          "source_id": "mlp:unconsciousness",
+          "source_excerpt": "If the person is unconscious from choking: Begin CPR . Chest compressions may help dislodge the object. If you see something blocking the airway and it is loose, try to remove it. If the object is lodged in the person's throat, do not try to grasp it.",
+          "disposition": "Carried by do[6].",
