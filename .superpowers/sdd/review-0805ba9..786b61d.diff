+      "remediation": {
+        "changed": true,
+        "before_card_sha256": "bb0bb04de2502a71a08140686c87d5854f12954af33873c8b998d7cd4056fdc5",
+        "after_card_sha256": "f5601f3a312a9084e4804f9c9e036e5e24187a3e003f85bc5fe95e100df552e0",
+        "modified_fields": [
+          {
+            "field_path": "do[1].t",
+            "before": "لو مش قادر تقفل التيار: استخدم حاجة ماتوصّلش كهربا — مقشة، كرسي، سجادة، أو دعّاسة كاوتش — عشان تبعّد الشخص عن المصدر.",
+            "after": "لو مش قادر تقفل التيار: قف على حاجة ناشفة ماتوصّلش كهربا، واستخدم مقشة أو كرسي أو دعّاسة كاوتش تبعّده."
+          },
+          {
+            "field_path": "do[3].t",
+            "before": "لو فاقد الوعي ومش حاسس بنبض، ابدأ إنعاش (CPR).",
+            "after": "لو مش بيتنفّس أو نفسه ضعيف، اعمل تنفّس إنقاذي. لو فاقد الوعي ومفيش نبض، ابدأ إنعاش (CPR)."
+          },
+          {
+            "field_path": "do[5].t",
+            "before": "لو باين عليه إغماء أو شحوب أو علامات صدمة: نيّمه وراسه أوطى شوية من جسمه.",
+            "after": "لو باين عليه إغماء أو شحوب: نيّمه، خلّي راسه أوطى شوية، وارفع رجليه وغطّيه بحاجة دافية."
+          },
+          {
+            "field_path": "dont[0].t",
+            "before": "ماتقربش أقل من ٦ متر من حد بيتصعق بكهربا ضغط عالي.",
+            "after": "ماتقربش أقل من ٦ متر من حد بيتصعق بكهربا ضغط عالي لحد ما الكهربا تتفصل."
+          }
+        ]
