+    {
+      "card_id": "chemical-burn",
+      "title": {
+        "ar": "حرق كيماوي",
+        "en": "Chemical burn or reaction"
+      },
+      "level": 4,
+      "card_sha256": "4d18df79d494b1d4771291be607f7b85637200efa87be295960437d272393407",
+      "sources": [
+        {
+          "source_id": "mlp:chemical-burn",
+          "url": "https://medlineplus.gov/ency/article/000059.htm",
+          "filename": "medlineplus-gov-ency-article-000059-htm-8ccc72eec0.html",
+          "sha256": "f709133db4a17dc6dc25bc03be18bba8c77a007b56e4700e47bdcffe4c6e5a6b",
+          "retrieval_date": "2026-08-02",
+          "retrieved_at": "2026-08-02T15:16:13.070Z",
+          "final_url": "https://medlineplus.gov/ency/article/000059.htm",
+          "source_metadata_sha256": "fe2e4f64d4",
+          "source_metadata_retrieved": null,
+          "licence": null
+        }
+      ],
+      "actionable_lines": [
+        {
+          "field_path": "do[0]",
+          "text": "اتأكد إن كل اللي بينقذوا لابسين وقاية مناسبة — ممكن تشمل واقي للعين ووقاية للجلد.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Symptoms Depending on the type of exposure, the symptoms may include: Abdominal pain Breathing difficulty Bright red or bluish skin and lips Convulsions ( seizures ) Dizziness Eye pain, burning or watering Headache Hives , itching , swelling , or weakness resulting from an allergic reaction Irritability Nausea and vomiting Pain where the skin has come in contact with the toxic substance Rash , blisters , burns on the skin Unconsciousness or other states of altered level of consciousness First Aid Make sure that all rescuers have appropriate safety gear, this may include eye protection and skin protection. Remove the victim from the area of exposure, or make sure the cause of the burn or exposure has been removed.",
+          "qualifier_or_exception": "No limiting qualifier in this supporting context.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[1]",
+          "text": "طلّع المصاب من مكان التعرّض، أو اتأكد إن سبب الحرق اتشال. حاول ماتلمسش المادة بنفسك. لو الكيماوي ناشف، انفض الزيادة بره من غير ما يطير في عينيك أو عين المصاب. اخلع أي هدوم أو مجوهرات.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Symptoms Depending on the type of exposure, the symptoms may include: Abdominal pain Breathing difficulty Bright red or bluish skin and lips Convulsions ( seizures ) Dizziness Eye pain, burning or watering Headache Hives , itching , swelling , or weakness resulting from an allergic reaction Irritability Nausea and vomiting Pain where the skin has come in contact with the toxic substance Rash , blisters , burns on the skin Unconsciousness or other states of altered level of consciousness First Aid Make sure that all rescuers have appropriate safety gear, this may include eye protection and skin protection. Remove the victim from the area of exposure, or make sure the cause of the burn or exposure has been removed. Try not to come in contact with it yourself. If the chemical is dry, brush off any excess. Avoid brushing it into your eyes or the victim's eyes. Remove any clothing and jewelry. Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[2]",
+          "text": "اغسل الكيماويات من على سطح الجلد بميّه باردة جارية لمدة ١٥ دقيقة أو أكتر — إلا لو التعرّض كان للجير الناشف (أكسيد الكالسيوم، اللي بيتسمّى كمان «الجير الحي») أو لمعادن زي الصوديوم والبوتاسيوم والمغنيسيوم والفوسفور والليثيوم.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Try not to come in contact with it yourself. If the chemical is dry, brush off any excess. Avoid brushing it into your eyes or the victim's eyes. Remove any clothing and jewelry. Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium. Treat the person for shock if they appear faint, pale, or if there is shallow, rapid breathing.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[3]",
+          "text": "عالج الشخص من الصدمة (الهبوط) لو باين عليه إغماء أو شحوب، أو لو تنفّسه سطحي وسريع.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium. Treat the person for shock if they appear faint, pale, or if there is shallow, rapid breathing. Apply cool, wet compresses to relieve pain.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[4]",
+          "text": "حُط كمّادات باردة مبلولة عشان تخفّف الألم.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium. Treat the person for shock if they appear faint, pale, or if there is shallow, rapid breathing. Apply cool, wet compresses to relieve pain. Wrap the burned area with a dry sterile dressing (if possible) or clean cloth.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[5]",
+          "text": "لفّ المكان المحروق بشاش معقّم وناشف (لو متوفّر) أو قماشة نضيفة، واحمي المكان من الضغط والاحتكاك.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium. Treat the person for shock if they appear faint, pale, or if there is shallow, rapid breathing. Apply cool, wet compresses to relieve pain. Wrap the burned area with a dry sterile dressing (if possible) or clean cloth. Protect the burned area from pressure and friction. Minor chemical burns will most often heal without further treatment.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[6]",
+          "text": "الحروق الكيماوية البسيطة غالبًا بتطيب من غير علاج إضافي. لكن لو فيه حرق من الدرجة التانية أو التالتة، أو رد فعل في الجسم كله، دوّر على مساعدة طبية فورًا. في الحالات الشديدة، ماتسبش الشخص لوحده وراقبه كويس لأي رد فعل بيأثّر على الجسم كله.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "Treat the person for shock if they appear faint, pale, or if there is shallow, rapid breathing. Apply cool, wet compresses to relieve pain. Wrap the burned area with a dry sterile dressing (if possible) or clean cloth. Protect the burned area from pressure and friction. Minor chemical burns will most often heal without further treatment. However, if there is a second or third-degree burn or if there is an overall body reaction, get medical help right away. In severe cases, don't leave the person alone and watch carefully for reactions affecting the entire body. Note: If a chemical gets into the eyes, flush them with water right away.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "do[7]",
+          "text": "لو المادة دخلت العين، اغسلها بميّه جارية فورًا لمدة ١٥ دقيقة على الأقل، واطلب مساعدة طبية فورًا.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "First Aid",
+          "source_excerpt": "However, if there is a second or third-degree burn or if there is an overall body reaction, get medical help right away. In severe cases, don't leave the person alone and watch carefully for reactions affecting the entire body. Note: If a chemical gets into the eyes, flush them with water right away. Continue to flush the eyes with running water for at least 15 minutes. Get medical help right away. DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[0]",
+          "text": "ماتحطّش أي وصفة بيتية زي مرهم أو دهان على الحرق الكيماوي.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Note: If a chemical gets into the eyes, flush them with water right away. Continue to flush the eyes with running water for at least 15 minutes. Get medical help right away. DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn. Do not become contaminated by the chemical as you give first aid.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[1]",
+          "text": "ماتخليش الكيماوي يتلوّثك إنت وانت بتسعف.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Continue to flush the eyes with running water for at least 15 minutes. Get medical help right away. DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn. Do not become contaminated by the chemical as you give first aid. Do not disturb a blister or remove dead skin from a chemical burn.",
+          "qualifier_or_exception": "No limiting qualifier in this supporting context.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[2]",
+          "text": "ماتفقعش أي فقاعة (بثرة) وماتشيلش الجلد الميت من الحرق.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "Get medical help right away. DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn. Do not become contaminated by the chemical as you give first aid. Do not disturb a blister or remove dead skin from a chemical burn. Do not try to neutralize any chemical without consulting the poison control center or a health care provider.",
+          "qualifier_or_exception": "No limiting qualifier in this supporting context.",
+          "card_carries": true,
+          "verdict": "PASS"
+        },
+        {
+          "field_path": "dont[3]",
+          "text": "ماتحاولش تعادل أي مادة كيماوية من غير ما تستشير مركز السموم أو دكتور.",
+          "source_id": "mlp:chemical-burn",
+          "source_context_section": "DO NOT / safety context",
+          "source_excerpt": "DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn. Do not become contaminated by the chemical as you give first aid. Do not disturb a blister or remove dead skin from a chemical burn. Do not try to neutralize any chemical without consulting the poison control center or a health care provider. When to Contact a Medical Professional Call for medical help right away if the person is having difficulty breathing, having seizures, or unconscious.",
+          "qualifier_or_exception": "All conditions and exceptions in this excerpt were checked against the complete card.",
+          "card_carries": true,
+          "verdict": "PASS"
+        }
+      ],
+      "source_qualifiers": [
+        {
+          "id": "rescuer-protection",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "Symptoms Depending on the type of exposure, the symptoms may include: Abdominal pain Breathing difficulty Bright red or bluish skin and lips Convulsions ( seizures ) Dizziness Eye pain, burning or watering Headache Hives , itching , swelling , or weakness resulting from an allergic reaction Irritability Nausea and vomiting Pain where the skin has come in contact with the toxic substance Rash , blisters , burns on the skin Unconsciousness or other states of altered level of consciousness First Aid Make sure that all rescuers have appropriate safety gear, this may include eye protection and skin protection.",
+          "disposition": "Carried by do[0] and dont[1].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "dry-chemical-brush-first",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "Symptoms Depending on the type of exposure, the symptoms may include: Abdominal pain Breathing difficulty Bright red or bluish skin and lips Convulsions ( seizures ) Dizziness Eye pain, burning or watering Headache Hives , itching , swelling , or weakness resulting from an allergic reaction Irritability Nausea and vomiting Pain where the skin has come in contact with the toxic substance Rash , blisters , burns on the skin Unconsciousness or other states of altered level of consciousness First Aid Make sure that all rescuers have appropriate safety gear, this may include eye protection and skin protection. Remove the victim from the area of exposure, or make sure the cause of the burn or exposure has been removed. Try not to come in contact with it yourself. If the chemical is dry, brush off any excess. Avoid brushing it into your eyes or the victim's eyes.",
+          "disposition": "Carried by do[1].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "water-exposure-exceptions",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "If the chemical is dry, brush off any excess. Avoid brushing it into your eyes or the victim's eyes. Remove any clothing and jewelry. Flush the chemicals off the skin surface using cool running water for 15 minutes or more unless the chemical exposure is to dry lime (calcium oxide, also called 'quick lime') or to elemental metals such as sodium, potassium, magnesium, phosphorous, and lithium.",
+          "disposition": "Carried completely by do[2].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "severity-escalation",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "Wrap the burned area with a dry sterile dressing (if possible) or clean cloth. Protect the burned area from pressure and friction. Minor chemical burns will most often heal without further treatment. However, if there is a second or third-degree burn or if there is an overall body reaction, get medical help right away.",
+          "disposition": "Carried by do[6], variations, and whoToCall.",
+          "verdict": "PASS"
+        },
+        {
+          "id": "eye-flush-fifteen-minutes",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "However, if there is a second or third-degree burn or if there is an overall body reaction, get medical help right away. In severe cases, don't leave the person alone and watch carefully for reactions affecting the entire body. Note: If a chemical gets into the eyes, flush them with water right away. Continue to flush the eyes with running water for at least 15 minutes.",
+          "disposition": "Carried by the added eye-specific actionable line.",
+          "verdict": "PASS"
+        },
+        {
+          "id": "no-unsupervised-neutralizing",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "DO NOT Do not apply any household remedy such as ointment or salve to a chemical burn. Do not become contaminated by the chemical as you give first aid. Do not disturb a blister or remove dead skin from a chemical burn. Do not try to neutralize any chemical without consulting the poison control center or a health care provider.",
+          "disposition": "Carried by dont[3].",
+          "verdict": "PASS"
+        },
+        {
+          "id": "breathing-seizure-unconscious-emergency",
+          "source_id": "mlp:chemical-burn",
+          "source_excerpt": "Do not try to neutralize any chemical without consulting the poison control center or a health care provider. When to Contact a Medical Professional Call for medical help right away if the person is having difficulty breathing, having seizures, or unconscious.",
+          "disposition": "Carried by redFlags and whoToCall.",
+          "verdict": "PASS"
+        }
+      ],
+      "overall_verdict": "PASS",
+      "reviewer_note": "Human full-card review against the complete fetched First Aid, DO NOT, and escalation context; no heuristic was used to award PASS.",
+      "remediation": {
+        "changed": true,
+        "before_card_sha256": "b2463f34c98234922da419cdcff8406c4856a5b5ea6d40e02f655bf442bd1cc5",
+        "after_card_sha256": "4d18df79d494b1d4771291be607f7b85637200efa87be295960437d272393407",
